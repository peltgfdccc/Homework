/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 
.searchBox{
	height: 60rpx;
	margin-top: 10rpx;
	margin-bottom: 10rpx;
	display: flex;
	justify-content: center;
}
.searchBox input{
	background-color: rgba(50, 50, 50, 0.2);
	height: 100%;
	width: 96%;
	border-radius: 60rpx;
	text-align: center;
}